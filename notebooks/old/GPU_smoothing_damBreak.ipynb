        "# Time full (transfer + compute + transfer back) vs compute only (data already on GPU)\n",
        "shape = case[\"shape\"]\n",
        "X_train_grid_gpu = cp.asarray(X_train_grid.reshape(-1, *shape).astype(np.float32))\n",
        "\n",
        "for name, wrapper, compute in [\n",
        "    (\"gpu2\", smooth_snapshots_gpu2, _smooth_gpu2_compute),\n",
        "    (\"gpu_separable\", smooth_snapshots_gpu_separable, _smooth_gpu_separable_compute),\n",
        "    (\"gpu_fft_reflect\", smooth_snapshots_gpu_fft_reflect, _smooth_gpu_fft_reflect_compute),\n",
        "    (\"gpu_fft_nearest\", smooth_snapshots_gpu_fft_nearest, _smooth_gpu_fft_nearest_compute),\n",
        "]:\n",
        "    t1 = datetime.now()\n",
        "    _ = wrapper(X_train_grid, case)\n",
        "    t2 = datetime.now()\n",
        "    cp.cuda.Stream.null.synchronize()\n",
        "    t3 = datetime.now()\n",
        "    _ = compute(X_train_grid_gpu, case)\n",
        "    cp.cuda.Stream.null.synchronize()\n",
        "    t4 = datetime.now()\n",
        "    print(name, \"full:\", round((t2 - t1).total_seconds(), 4), \"s\", \"| compute only:\", round((t4 - t3).total_seconds(), 4), \"s\")"
      ]
    },
