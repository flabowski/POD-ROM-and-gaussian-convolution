        "t2 = datetime.now()\n",
        "print(\"smooth_snapshots_gpu_gaussian_filter:\", (t2 - t1).total_seconds(), \"s\")\n",
        "print(\"same output?\", np.allclose(X_train_grid_s_cpu, X_train_grid_s_gpu_gf))\n",
