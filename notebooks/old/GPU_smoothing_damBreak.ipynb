      "source": [
        "# Time all variants (functions defined in cell above)\n",
        "# Warm-up GPU (JIT + context init) so first timed GPU call isn't slow\n",
        "_ = smooth_snapshots_gpu0(X_train_grid[:1], case)\n",
        "_ = smooth_snapshots_gpu0_f32(X_train_grid[:1], case)\n",
        "_ = smooth_snapshots_gpu1(X_train_grid[:1], case)\n",
        "_ = smooth_snapshots_gpu2(X_train_grid[:1], case)\n",
        "_ = smooth_snapshots_gpu_gaussian_filter(X_train_grid[:1], case)\n",
