        "_ = smooth_snapshots_gpu_fft_reflect(X_train_grid[:1], case)\n",
        "_ = smooth_snapshots_gpu_fft_nearest(X_train_grid[:1], case)\n",
        "cp.cuda.Stream.null.synchronize()\n",
