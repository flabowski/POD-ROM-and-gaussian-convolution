        "print(\"smooth_snapshots_gpu0_f32:\", (t2 - t1).total_seconds(), \"s\")\n",
        "print(\"same output?\", np.allclose(X_train_grid_s_cpu, X_train_grid_s_gpu0_f32))\n",
        "\n",
        "t1 = datetime.now()\n",
        "X_train_grid_s_gpu1 = smooth_snapshots_gpu1(X_train_grid, case)\n",
        "t2 = datetime.now()\n",
        "print(\"smooth_snapshots_gpu1:\", (t2 - t1).total_seconds(), \"s\")\n",
        "print(\"same output?\", np.allclose(X_train_grid_s_cpu, X_train_grid_s_gpu1))\n",
        "\n",
        "t1 = datetime.now()\n",
        "X_train_grid_s_gpu2 = smooth_snapshots_gpu2(X_train_grid, case)\n",
        "t2 = datetime.now()\n",
        "print(\"smooth_snapshots_gpu2:\", (t2 - t1).total_seconds(), \"s\")\n",
        "print(\"same output?\", np.allclose(X_train_grid_s_cpu, X_train_grid_s_gpu2))\n",
