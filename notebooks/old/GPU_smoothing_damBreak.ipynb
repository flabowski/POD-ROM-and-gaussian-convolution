      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.interpolate import griddata\n",
        "from scipy.ndimage import gaussian_filter\n",
        "import cupy as cp\n",
        "from cupyx.scipy.ndimage import gaussian_filter as gaussian_filter_gpu\n",
        "from cupyx.scipy.ndimage import convolve1d as convolve1d_gpu\n",
        "from datetime import datetime"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {},
      "outputs": [],
      "source": [
        "pth_local_dbCoarseOLD = \"C:/Users/florianma/OneDrive - Institutt for Energiteknikk/Documents/convolution_paper/data/DamBreak/\"\n",
        "ts = 0.25\n",
        "\n",
        "n_x = n_y = 512\n",
        "x = np.linspace(0, 0.584, n_x, endpoint=True)\n",
        "y = np.linspace(0, 0.584, n_y, endpoint=True)\n",
        "X, Y = np.meshgrid(x, y, indexing=\"ij\")\n",
        "case = {\n",
        "    \"sigma\": 0.013,\n",
        "    \"shape\": X.shape,\n",
        "    \"dx\": x[1] - x[0],\n",
        "    \"mode\": \"nearest\",\n",
        "    \"truncate\": 8,\n",
        "}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {},
      "outputs": [],
      "source": [
        "X_train = np.load(pth_local_dbCoarseOLD + \"t{:.2f}_X_train.npy\".format(ts)).T\n",
        "points = np.load(pth_local_dbCoarseOLD + \"points.npy\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {},
      "outputs": [],
      "source": [
        "X_train_grid = np.empty((len(X_train), n_x * n_y))\n",
        "gridded = griddata(points[:, :2], X_train.T, (X, Y), method=\"linear\")\n",
        "failed = np.isnan(gridded)\n",
        "gridded[failed] = griddata(points[:, :2], X_train.T, (X, Y), method=\"nearest\")[failed]\n",
        "X_train_grid[:] = gridded.reshape((n_x * n_y, len(X_train))).T"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Smoothing variants (kept for performance documentation):\n",
        "- **smooth_snapshots_rw**: CPU, loop + scipy.ndimage.gaussian_filter\n",
        "- **smooth_snapshots_gpu0**: GPU, transfer each snapshot in loop (CPU→GPU, filter, GPU→CPU per snapshot)\n",
        "- **smooth_snapshots_gpu0_f32**: GPU, same as gpu0 but float32 before transfer (still transfer in loop)\n",
        "- **smooth_snapshots_gpu1**: GPU, single transfer + loop of 2D gaussian_filter_gpu\n",
        "- **smooth_snapshots_gpu2**: GPU, batched 3D gaussian_filter_gpu(sigma=(0,sgm,sgm))\n",
        "- **smooth_snapshots_gpu_gaussian_filter**: GPU, batched 3D cupyx.scipy.ndimage.gaussian_filter (explicit benchmark)\n",
        "- **smooth_snapshots_gpu_separable**: GPU, batched separable 1D convolve1d (fastest)\n",
        "- **smooth_snapshots_gpu_fft**: GPU, batched FFT with analytic Gaussian in freq domain. Truly reflect (concat x[::-1], x, x[::-1]) then crop.\n",
        "\n",
        "All non-FFT variants use `case[\"truncate\"]` (e.g. 20).\n",
        "\n",
        "Timing cell runs a 1-snapshot warm-up of all GPU paths first so JIT/context init doesn't skew the first timed run."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {},
      "outputs": [],
      "source": [
        "def smooth_snapshots_rw(X, case):\n",
        "    \"\"\"CPU: loop + scipy.ndimage.gaussian_filter.\"\"\"\n",
        "    sgm = case[\"sigma\"] / case[\"dx\"]\n",
        "    mode = case[\"mode\"]\n",
        "    truncate = case[\"truncate\"]\n",
        "    out = np.empty_like(X)\n",
        "    for j in range(len(X)):\n",
        "        ss2D = X[j].reshape(case[\"shape\"])\n",
        "        out[j] = gaussian_filter(ss2D, sigma=sgm, truncate=truncate, mode=mode).ravel()\n",
        "    return out\n",
        "\n",
        "\n",
        "def smooth_snapshots_gpu0(X, case):\n",
        "    \"\"\"GPU: transfer each snapshot in loop (CPU→GPU, filter, GPU→CPU per snapshot). First version.\"\"\"\n",
        "    sgm = case[\"sigma\"] / case[\"dx\"]\n",
        "    shape = case[\"shape\"]\n",
        "    truncate = case[\"truncate\"]\n",
        "    out = np.empty_like(X)\n",
        "    for j in range(len(X)):\n",
        "        ss2D = X[j].reshape(shape)\n",
        "        ss_gpu = cp.asarray(ss2D)\n",
        "        smoothed = cp.asnumpy(gaussian_filter_gpu(ss_gpu, sigma=sgm, truncate=truncate, mode=case[\"mode\"]))\n",
        "        out[j] = smoothed.ravel()\n",
        "    return out\n",
        "\n",
        "\n",
        "def smooth_snapshots_gpu0_f32(X, case):\n",
        "    \"\"\"GPU: same as gpu0 but float32 before transfer (still transfer in loop).\"\"\"\n",
        "    sgm = case[\"sigma\"] / case[\"dx\"]\n",
        "    shape = case[\"shape\"]\n",
        "    truncate = case[\"truncate\"]\n",
        "    out = np.empty((len(X), X.shape[1]), dtype=np.float32)\n",
        "    for j in range(len(X)):\n",
        "        ss2D = X[j].reshape(shape).astype(np.float32)\n",
        "        ss_gpu = cp.asarray(ss2D)\n",
        "        smoothed = cp.asnumpy(gaussian_filter_gpu(ss_gpu, sigma=sgm, truncate=truncate, mode=case[\"mode\"]))\n",
        "        out[j] = smoothed.ravel()\n",
        "    return out\n",
        "\n",
        "\n",
        "def smooth_snapshots_gpu1(X, case):\n",
        "    \"\"\"GPU: single transfer + loop of 2D gaussian_filter_gpu.\"\"\"\n",
        "    sgm = case[\"sigma\"] / case[\"dx\"]\n",
        "    shape = case[\"shape\"]\n",
        "    truncate = case[\"truncate\"]\n",
        "    X_gpu = cp.asarray(X.astype(np.float32))\n",
        "    for j in range(len(X)):\n",
        "        ss2D = X_gpu[j].reshape(shape)\n",
        "        X_gpu[j] = gaussian_filter_gpu(ss2D, sigma=sgm, truncate=truncate, mode=case[\"mode\"]).ravel()\n",
        "    return cp.asnumpy(X_gpu)\n",
        "\n",
        "\n",
        "def smooth_snapshots_gpu2(X, case):\n",
        "    \"\"\"GPU: batched 3D gaussian_filter_gpu(sigma=(0, sgm, sgm)).\"\"\"\n",
        "    sgm = case[\"sigma\"] / case[\"dx\"]\n",
        "    shape = case[\"shape\"]\n",
        "    truncate = case[\"truncate\"]\n",
        "    X_gpu = cp.asarray(X.reshape(-1, *shape).astype(np.float32))\n",
        "    smoothed = gaussian_filter_gpu(X_gpu, sigma=(0, sgm, sgm), truncate=truncate, mode=case[\"mode\"])\n",
        "    return cp.asnumpy(smoothed).reshape(len(X), -1)\n",
        "\n",
        "\n",
        "def smooth_snapshots_gpu_gaussian_filter(X, case):\n",
        "    \"\"\"GPU: batched 3D cupyx.scipy.ndimage.gaussian_filter (explicit benchmark entry).\"\"\"\n",
        "    return smooth_snapshots_gpu2(X, case)\n",
        "\n",
        "\n",
        "def smooth_snapshots_gpu_separable(X, case):\n",
        "    \"\"\"GPU: batched separable 1D Gaussian convolutions (horizontal then vertical).\"\"\"\n",
        "    sgm = case[\"sigma\"] / case[\"dx\"]\n",
        "    shape = case[\"shape\"]\n",
        "    truncate = case[\"truncate\"]\n",
        "    radius = int(truncate * sgm + 0.5)\n",
        "    x = cp.arange(-radius, radius + 1, dtype=cp.float32)\n",
        "    kernel = cp.exp(-(x ** 2) / (2 * sgm ** 2))\n",
        "    kernel /= kernel.sum()\n",
        "    imgs = cp.asarray(X.reshape(-1, *shape).astype(np.float32))\n",
        "    tmp = convolve1d_gpu(imgs, kernel, axis=2, mode=case[\"mode\"])\n",
        "    out = convolve1d_gpu(tmp, kernel, axis=1, mode=case[\"mode\"])\n",
        "    return cp.asnumpy(out).reshape(len(X), -1)\n",
        "\n",
        "\n",
        "def smooth_snapshots_gpu_fft_reflect(X, case):\n",
        "    \"\"\"GPU: batched FFT smoothing. Analytic Gaussian in freq domain. Truly reflect (concat x[::-1], x, x[::-1]) then crop.\"\"\"\n",
        "    sgm = case[\"sigma\"] / case[\"dx\"]\n",
        "    shape = case[\"shape\"]\n",
        "    truncate = case[\"truncate\"]\n",
        "    n_x, n_y = shape\n",
        "    pad = 2 * int(truncate * sgm + 0.5)\n",
        "    imgs = cp.asarray(X.reshape(-1, n_x, n_y).astype(np.float32))\n",
        "    # Truly reflect: concatenate [x[::-1], x, x[::-1]] in each spatial direction (no pad(), explicit flip)\n",
        "    # imgs_pad = cp.pad(imgs, ((0, 0), (pad, pad), (pad, pad)), mode=\"reflect\") did not seem to work\n",
        "    imgs_x = cp.concatenate([imgs[:, pad - 1 :: -1, :], imgs, imgs[:, -1 : -pad - 1 : -1, :]], axis=1)\n",
        "    imgs_pad = cp.concatenate([imgs_x[:, :, pad - 1 :: -1], imgs_x[:, :, :], imgs_x[:, :, -1 : -pad - 1 : -1]], axis=2)\n",
        "    n_x_pad, n_y_pad = imgs_pad.shape[1], imgs_pad.shape[2]\n",
        "    fx = cp.fft.fftfreq(n_x_pad, d=1.0)\n",
        "    fy = cp.fft.fftfreq(n_y_pad, d=1.0)\n",
        "    FX, FY = cp.meshgrid(fx, fy, indexing=\"ij\")\n",
        "    H = cp.exp(-2 * cp.pi**2 * sgm**2 * (FX**2 + FY**2)).astype(cp.float32)\n",
        "    F = cp.fft.fft2(imgs_pad, axes=(-2, -1))\n",
        "    out_pad = cp.fft.ifft2(F * H, axes=(-2, -1)).real\n",
        "    out = out_pad[:, pad : pad + n_x, pad : pad + n_y]\n",
        "    return cp.asnumpy(out).reshape(len(X), -1)\n",
        "\n",
        "def smooth_snapshots_gpu_fft_nearest(X, case):\n",
        "    \"\"\"GPU: batched FFT smoothing. Analytic Gaussian. Nearest (repeat edge) padding then crop.\"\"\"\n",
        "    sgm = case[\"sigma\"] / case[\"dx\"]\n",
        "    shape = case[\"shape\"]\n",
        "    truncate = case[\"truncate\"]\n",
        "    n_x, n_y = shape\n",
        "    pad = 2 * int(truncate * sgm + 0.5)\n",
        "    imgs = cp.asarray(X.reshape(-1, n_x, n_y).astype(np.float32))\n",
        "    left = cp.tile(imgs[:, 0:1, :], (1, pad, 1))\n",
        "    right = cp.tile(imgs[:, -1:, :], (1, pad, 1))\n",
        "    imgs_x = cp.concatenate([left, imgs, right], axis=1)\n",
        "    top = cp.tile(imgs_x[:, :, 0:1], (1, 1, pad))\n",
        "    bottom = cp.tile(imgs_x[:, :, -1:], (1, 1, pad))\n",
        "    imgs_pad = cp.concatenate([top, imgs_x, bottom], axis=2)\n",
        "    n_x_pad, n_y_pad = imgs_pad.shape[1], imgs_pad.shape[2]\n",
        "    fx = cp.fft.fftfreq(n_x_pad, d=1.0)\n",
        "    fy = cp.fft.fftfreq(n_y_pad, d=1.0)\n",
        "    FX, FY = cp.meshgrid(fx, fy, indexing=\"ij\")\n",
        "    H = cp.exp(-2 * cp.pi**2 * sgm**2 * (FX**2 + FY**2)).astype(cp.float32)\n",
        "    F = cp.fft.fft2(imgs_pad, axes=(-2, -1))\n",
        "    out_pad = cp.fft.ifft2(F * H, axes=(-2, -1)).real\n",
        "    out = out_pad[:, pad : pad + n_x, pad : pad + n_y]\n",
        "    return cp.asnumpy(out).reshape(len(X), -1)"
      ]
    },
